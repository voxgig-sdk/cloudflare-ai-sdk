# BasicAiGatewayLogFlow

main: kit: flow: BasicAiGatewayLogFlow:
{
  entity: "ai_gateway_log",
  kind: "basic",
  name: "BasicAiGatewayLogFlow",
  step: [
    {
      m: {
        account_id: "account01",
        gateway_id: "gateway01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ai_gateway_log_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01",
        gateway_id: "gateway01"
      }

      i: {
        ref: "ai_gateway_log_ref01",
        srcdatavar: "ai_gateway_log_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ai_gateway_log_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ai_gateway_log_ref01",
        srcdatavar: "ai_gateway_log_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        gateway_id: "gateway01",
        id: "ai_gateway_log01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ai_gateway_log_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAiGatewayLogFlow"
}