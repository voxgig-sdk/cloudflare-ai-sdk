# BasicAiSearchInstanceFlow

main: kit: flow: BasicAiSearchInstanceFlow:
{
  entity: "ai_search_instance",
  kind: "basic",
  name: "BasicAiSearchInstanceFlow",
  step: [
    {
      i: {
        ref: "ai_search_instance_ref01"
      }

      m: {
        account_id: "account01",
        name: "name01",
        namespace_id: "namespace01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "ai_search_instance_ref01"
          }
        }
      ]
    }

    {
      d: {
        account_id: "account01"
      }

      i: {
        ref: "ai_search_instance_ref01",
        srcdatavar: "ai_search_instance_ref01_data",
        suffix: "_up0",
        textfield: "ai_gateway_id"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ai_search_instance_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ai_search_instance_ref01",
        srcdatavar: "ai_search_instance_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "ai_search_instance01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ai_search_instance_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "ai_search_instance_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "ai_search_instance01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "ai_search_instance_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAiSearchInstanceFlow"
}