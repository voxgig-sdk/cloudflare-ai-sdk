# BasicAutoRagJobFlow

main: kit: flow: BasicAutoRagJobFlow:
{
  entity: "auto_rag_job",
  kind: "basic",
  name: "BasicAutoRagJobFlow",
  step: [
    {
      m: {
        account_id: "account01",
        rag_id: "rag01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "auto_rag_job_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "auto_rag_job_ref01",
        srcdatavar: "auto_rag_job_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "auto_rag_job01",
        rag_id: "rag01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-auto_rag_job_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAutoRagJobFlow"
}